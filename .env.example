# Copy to .env for local development. Never commit .env.
PORT=3000
BASE_URL=http://localhost:3000
NODE_ENV=development
LOG_LEVEL=info

# Milestone 1: PostgreSQL (Docker Compose defaults match these).
DATABASE_URL=postgres://shortly:shortly@localhost:5432/shortly
POSTGRES_USER=shortly
POSTGRES_PASSWORD=shortly
POSTGRES_DB=shortly
POSTGRES_PORT=5432

# Local frontend origin for non-production CORS.
CORS_ORIGIN=http://localhost:3001

# Future milestones (placeholders, not used yet):
# REDIS_URL=redis://localhost:6379
# RABBITMQ_URL=amqp://guest:guest@localhost:5672
# REDIS_TTL=3600
# RATE_LIMIT_WINDOW=60
# RATE_LIMIT_MAX_REQUESTS=100

{
  "info": {
    "_postman_id": "b7d4a1e2-3c5f-4a8b-9d21-6e0f7c8a4b53",
    "name": "Shortly API",
    "description": "Runnable collection for the Shortly URL shortener. Requests are ordered to chain variables: Auth sets {{token}}, Create captures {{shortCode}}, and later requests reuse both.\n\nRate limits are per-IP and real: /auth/* allows 10/min, guest creates 10/hour. Rapid re-runs will 429 by design.\n\nThe Redirect request expects a 302. Turn off 'Automatically follow redirects' in the request settings, otherwise Postman follows the Location header and the test never sees the 302.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Health & Info",
      "description": "Public. No auth, no rate limit concerns — safe to hammer.",
      "item": [
        {
          "name": "API info",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/",
              "host": ["{{baseUrl}}"],
              "path": [""]
            },
            "description": "Basic service info plus the docs/metrics paths."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Returns service name', () => {",
                  "  const body = pm.response.json();",

    {
      "name": "Live Stream (manual only)",
      "description": "NOT part of automated runs: an SSE stream never terminates, so any runner (Postman runner, Newman) would hang or time out on it. To use it, open the request, hit Send, and watch frames arrive as `event: <type>` / `data: <json>` with a `:ping` comment every 20s. Stop it manually. Requires {{token}} and a {{shortCode}} you own.",
      "item": [
        {
          "name": "Live analytics stream (SSE)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "text/event-stream"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/urls/{{shortCode}}/analytics/stream",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "urls", "{{shortCode}}", "analytics", "stream"]
            },
            "description": "Owner-only live stream. This is a fetch() stream carrying the Bearer header, NOT EventSource — the browser cannot attach headers to EventSource.\n\nManual check: the response stays open and frames arrive as `event: <type>` / `data: <json>`, with a `:ping` comment every 20s. Postman's stream viewer will not terminate on its own; stop the request manually. Treat failures here as informational, not as a collection failure."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// The stream never terminates; --timeout-request aborts the",
                  "// socket. Only assert when a real response came back, so an",
                  "// abort is not reported as a contract failure.",
                  "if (pm.response.code === 0 || pm.response.headers.get('content-type') === null) {",
                  "  pm.test('Stream opened (aborted by timeout, as designed)', () => pm.expect(true).to.be.true);",
                  "} else {",
                  "  pm.test('SSE headers set', () => {",
                  "    pm.expect(pm.response.headers.get('content-type')).to.include('text/event-stream');",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    }

    {
      "name": "Redirect",
      "description": "The high-throughput path: Redis cache-aside, PostgreSQL on miss, 302 out. Analytics are fire-and-forget and never block the response.\n\nFolder creates its own target link — earlier folders delete their codes.",
      "item": [
        {
          "name": "Create a target to follow",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"url\": \"https://example.com/redirect-target\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/urls",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "urls"]
            },
            "description": "Creates its own live link instead of reusing {{shortCode}} — the Manage URLs folder already deleted that one, so following it would correctly answer 410, not 302."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "pm.test('Captures a live code', () => {",
                  "  pm.environment.set('redirectCode', pm.response.json().shortCode);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Follow live code (expects 302)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/{{redirectCode}}",
              "host": ["{{baseUrl}}"],
              "path": ["{{redirectCode}}"]
            },
            "description": "302 Found — deliberately NOT 301. A 301 is cached permanently by browsers, which would both break expiry/deactivation and stop counting later clicks.\n\nDisable 'Automatically follow redirects' on this request, or Postman follows Location and the 302 test never runs.\n\nAuto-follow is disabled IN the collection (protocolProfileBehavior.followRedirects=false), so the runner asserts on the 302 itself instead of chasing Location. If you duplicate this request, re-disable follow or the test never sees the 302."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 302', () => pm.response.to.have.status(302));",
                  "pm.test('Location header present', () => {",
                  "  pm.expect(pm.response.headers.get('location')).to.be.a('string').and.not.be.empty;",
                  "});"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "followRedirects": false
          }
        },
        {
          "name": "Follow deleted code (expects 410)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/{{deletedCode}}",
              "host": ["{{baseUrl}}"],
              "path": ["{{deletedCode}}"]
            },
            "description": "Deactivation is lazy: the row survives with is_active=false, so a deleted link answers 410 Gone rather than 404. Cache invalidation is best-effort, so this can lag by up to the 60s negative TTL.\n\nAuto-follow is disabled IN the collection (protocolProfileBehavior.followRedirects=false), so the runner asserts on the 302 itself instead of chasing Location. If you duplicate this request, re-disable follow or the test never sees the 302."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 410', () => pm.response.to.have.status(410));",
                  "pm.test('Gone envelope', () => {",
                  "  pm.expect(pm.response.json().error).to.eql('Gone');",
                  "});"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "followRedirects": false
          }
        },
        {
          "name": "Unknown code (expects 404)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/this-code-does-not-exist-999",
              "host": ["{{baseUrl}}"],
              "path": ["this-code-does-not-exist-999"]
            },
            "description": "Negative test. Unknown codes are cached as negatives for 60s so repeated probes do not hammer PostgreSQL.\n\nAuto-follow is disabled IN the collection (protocolProfileBehavior.followRedirects=false), so the runner asserts on the 302 itself instead of chasing Location. If you duplicate this request, re-disable follow or the test never sees the 302."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 404', () => pm.response.to.have.status(404));",
                  "pm.test('NotFound envelope', () => {",
                  "  pm.expect(pm.response.json().error).to.eql('NotFound');",
                  "});"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "followRedirects": false
          }
        }
      ]
    },
    {
      "name": "Cleanup (run last)",
      "description": "Invalidates the session. Run this folder last, or re-run Auth before anything else.",
      "item": [
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "logout"]
            },
            "description": "204. Deletes the session row outright rather than waiting out the TTL.\n\nIn its own Cleanup folder at the end of the collection. Logout invalidates {{token}}, so running it early 401s the rest of the run."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Status is 204', () => pm.response.to.have.status(204));"]
              }
            }
          ]
        }
      ]

      ]
    },
    {
      "name": "Auth",
      "description": "Register/login return a bearer token. {{token}} is captured automatically and inherited by every request that uses collection-level auth.\n\nLogout is deliberately NOT here — it is in the final Cleanup folder, because it deletes the session row and would 401 every authed request that follows it.",
      "item": [
        {
          "name": "Register",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "register"]
            },
            "description": "201 with {token, user}. Password must be 8–72 chars; email is lowercased server-side.\n\n409 if the email is already registered — for repeat runs either change {{email}} or use Login instead."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Unique email per run so re-registration does not 409.",
                  "const unique = `${Date.now()}@example.com`;",
                  "pm.variables.set('email', unique);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "pm.test('Captures token and userId', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.token).to.be.a('string').and.not.be.empty;",
                  "  pm.expect(body.user.id).to.be.a('string');",
                  "  pm.environment.set('token', body.token);",
                  "  pm.environment.set('userId', body.user.id);",
                  "  pm.environment.set('email', body.user.email);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            },
            "description": "200 with {token, user}. Shares the 10/min per-IP credential budget with Register.\n\nRun Register first on a fresh environment; {{email}} is only set by that request or by a pre-request script."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Captures token', () => {",
                  "  const body = pm.response.json();",
                  "  pm.environment.set('token', body.token);",
                  "  pm.environment.set('email', body.user.email);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "me"]
            },
            "description": "401 if the token is missing, expired (default 7 days) or malformed. Present-but-invalid bearer is never downgraded to a guest."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Email matches session', () => {",
                  "  pm.expect(pm.response.json().email).to.eql(pm.environment.get('email'));",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Guest Flow",
      "description": "Anonymous identity: no bearer means the server mints a guestId. Send it back as X-Guest-Token to keep minting under the same anchor, then claim the links onto an account.\n\nBudget is strict: 10 guest creates per hour per IP.",
      "item": [
        {
          "name": "Create (anonymous, mints guestId)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"url\": \"https://example.com/guest-anonymous\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/urls",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "urls"]
            },
            "description": "Auth is optional on create. With no bearer and no X-Guest-Token the server mints a new anchor and returns it as guestId — capture it to keep building on the same identity."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "pm.test('Captures guestId', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.guestId).to.be.a('string');",
                  "  pm.environment.set('guestId', body.guestId);",
                  "  pm.environment.set('shortCode', body.shortCode);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Create (with X-Guest-Token)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Guest-Token",
                "value": "{{guestId}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"url\": \"https://example.com/guest-tagged\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/urls",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "urls"]
            },
            "description": "Replays the captured anchor so both rows land on one identity and can be claimed together.\n\nRequires the previous request to have run. A malformed/unknown X-Guest-Token is a 400 GUEST_TOKEN_INVALID — not silently ignored."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "pm.test('Reused the anchor (no new guestId minted)', () => {",
                  "  const body = pm.response.json();",
                  "  // A valid X-Guest-Token reuses the existing anchor, so the",
                  "  // server omits guestId. Its presence would mean the header",
                  "  // was ignored and a fresh identity was minted instead.",
                  "  pm.expect(body.guestId, 'guestId should be absent when the token is honored').to.not.exist;",
                  "  pm.environment.set('shortCode', body.shortCode);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Claim guest links",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"guestId\": \"{{guestId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/urls/claim",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "urls", "claim"]
            },
            "description": "200 with {claimed: [shortCodes]}. Idempotent by design — an unknown or already-claimed guestId returns {claimed: []}, never an error, so retrying is always safe.\n\nRequires {{token}} (run Auth first). This is why running Logout before this request breaks the flow."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Claimed is an array', () => {",
                  "  pm.expect(pm.response.json().claimed).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Create URLs",
      "description": "Authed creates. Accounts share a 100/min write budget — far looser than the guest bucket.",
      "item": [
        {
          "name": "Create (authed)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"url\": \"https://example.com/a/very/long/path?with=query\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/urls",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "urls"]
            },
            "description": "201 with shortCode/shortUrl/originalUrl. The generated shortCode is captured here so every request below chains off a real link you just made."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "pm.test('Captures shortCode and shortUrl', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.shortCode).to.be.a('string').and.not.be.empty;",
                  "  pm.expect(body.originalUrl).to.include('example.com');",
                  "  pm.environment.set('shortCode', body.shortCode);",
                  "  pm.environment.set('shortUrl', body.shortUrl);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Create (custom alias)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"url\": \"https://github.com/nayan-kunwar/shortly\",\n  \"customAlias\": \"{{alias}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/urls",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "urls"]
            },
            "description": "Alias rules: 3–30 chars, [A-Za-z0-9_-], no reserved words, case-sensitive. A pre-request script appends a timestamp so re-runs do not 409 on a taken alias.\n\nUniqueness is enforced by a DB unique constraint, not a check-then-insert, so concurrent creates are race-safe."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Avoids 409 AliasConflict on repeat runs.",
                  "pm.variables.set('alias', `gh-${Date.now()}`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "pm.test('Alias honored', () => {",
                  "  pm.expect(pm.response.json().shortCode).to.eql(pm.variables.get('alias'));",
                  "});",
                  "// Capture only on success: a 409 here would otherwise",
                  "// overwrite {{shortCode}} with undefined and 404 everything after.",
                  "if (pm.response.code === 201) pm.environment.set('shortCode', pm.response.json().shortCode);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create (with expiry)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"url\": \"https://example.com/ephemeral\",\n  \"expiresAt\": \"{{expiryIso}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/urls",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "urls"]
            },
            "description": "expiresAt must be a future ISO 8601 timestamp WITH an offset — a bare Z or a past time is a 400. The pre-request script computes one day ahead so the example always validates.\n\nExpiry is lazy: an expired link answers 410 on read rather than being swept eagerly."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Future ISO 8601 with a real offset. zod datetime({offset:true})",
                  "// rejects a trailing Z and a past timestamp, so compute +24h.",
                  "// Plain name: $-prefixed Postman vars are reserved built-ins.",
                  "const d = new Date(Date.now() + 24 * 60 * 60 * 1000);",
                  "pm.variables.set('expiryIso', d.toISOString().slice(0, -1) + '+00:00');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) pm.environment.set('shortCode', pm.response.json().shortCode);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create (invalid URL → 400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"url\": \"not-a-valid-url\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/urls",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "urls"]
            },
            "description": "Negative test, expected to fail. The contract is {error, message, details[{path, message}]} — details map to per-field form errors in the UI. Only http/https are accepted."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400', () => pm.response.to.have.status(400));",
                  "pm.test('Returns validation envelope', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.error).to.eql('ValidationError');",
                  "  pm.expect(body.details).to.be.an('array').and.not.be.empty;",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Manage URLs",
      "description": "Reads and lifecycle. All authed, all user-scoped — you only ever see your own links.",
      "item": [
        {
          "name": "List URLs",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/urls?limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "urls"],
              "query": [
                {
                  "key": "limit",
                  "value": "20",
                  "description": "1–100, default 20"
                },
                {
                  "key": "search",
                  "value": "",
                  "description": "Optional, max 100 chars",
                  "disabled": true
                },
                {
                  "key": "cursor",
                  "value": "",
                  "description": "Opaque nextCursor from a prior page",
                  "disabled": true
                }
              ]
            },
            "description": "Keyset pagination, newest first. Cursor is opaque (url:<id>) — pass back nextCursor verbatim; hand-rolling one is a 400. There is no total count by design."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Returns page envelope', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.items).to.be.an('array');",
                  "  pm.expect(body).to.have.property('nextCursor');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "URL details",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/urls/{{shortCode}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "urls", "{{shortCode}}"]
            },
            "description": "Lifetime click count plus lifecycle fields. 404 for unknown codes, 401 without a valid token. Uses {{shortCode}} from Create."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Clicks is an integer', () => {",
                  "  pm.expect(pm.response.json().clicks).to.be.a('number');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete (soft)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/urls/{{shortCode}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "urls", "{{shortCode}}"]
            },
            "description": "Soft delete — the row stays, is_active flips false, and reads answer 410 Gone. Idempotent: deleting an already-deleted code still returns 200 with the end state.\n\nCache invalidation is best-effort, so a deactivated link can keep redirecting for up to the 60s negative TTL."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Now inactive', () => {",
                  "  pm.expect(pm.response.json().isActive).to.be.false;",
                  "});",
                  "// Stash it: the Redirect folder proves a deleted link answers 410.",
                  "pm.environment.set('deletedCode', pm.environment.get('shortCode'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Analytics",
      "description": "Eventual consistency is real here: a click becomes visible only after outbox → publisher → RabbitMQ → worker → DB. Wait a few seconds after Redirect before expecting numbers.",
      "item": [
        {
          "name": "URL analytics",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/urls/{{shortCode}}/analytics",
              "host": ["{{baseUrl}}"],

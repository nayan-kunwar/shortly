# ── Local development (Docker Compose or localhost services) ──────────────
PORT=3000
BASE_URL=http://localhost:3000
NODE_ENV=development
LOG_LEVEL=info

# PostgreSQL (Docker Compose defaults match these).
DATABASE_URL=postgres://shortly:shortly@localhost:5432/shortly
POSTGRES_USER=shortly
POSTGRES_PASSWORD=shortly
POSTGRES_DB=shortly
POSTGRES_PORT=5432

# Frontend origin for non-production CORS.
CORS_ORIGIN=http://localhost:3001

# Redis cache-aside (seconds).
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379
REDIS_TTL=3600

# Fixed-window rate limiting (per IP, per route).
RATE_LIMIT_WINDOW=60
RATE_LIMIT_MAX_REQUESTS=100

# Anonymous-create budget (per IP). Guest endpoints mint rows for strangers.
GUEST_CREATE_WINDOW_SECONDS=3600
GUEST_CREATE_MAX_REQUESTS=10

# Bearer session lifetime in seconds (default 7 days).
AUTH_SESSION_TTL_SECONDS=604800

# RabbitMQ event transport.
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Nginx entry point (API replicas stay internal).
NGINX_PORT=8080

# ── External services (Render env vars override these) ───────────────────
# DATABASE_URL=postgresql://neondb_owner:npg_...@ep-...pooler.../neondb?sslmode=require
# REDIS_URL=rediss://default:...@...upstash.io:6379
# RABBITMQ_URL=amqps://...:...@warthog.lmq.cloudamqp.com/...
# BASE_URL=https://your-api.onrender.com
# CORS_ORIGIN=https://your-app.vercel.app
